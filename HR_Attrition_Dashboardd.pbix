<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Name - Data Analyst Portfolio</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; line-height: 1.6; }
        h1, h2 { color: #333; }
        section { margin-bottom: 40px; }
        img { max-width: 100%; height: auto; }
        iframe { width: 100%; height: 600px; border: none; }
    </style>
</head>
<body>
    <header>
        <h1>Your Name</h1>
        <p>Data Analyst | Power BI, SQL, Python | <a href="https://linkedin.com/in/yourprofile">LinkedIn</a></p>
    </header>

    <section>
        <h2>About Me</h2>
        <p>Passionate data analyst with experience in turning data into insights...</p>
    </section>

    <section>
        <h2>Projects</h2>
        
        <h3>Project 1: Sales Dashboard</h3>
        <p>Description of the project, tools used (Power BI, DAX), key insights.</p>
        <!-- Screenshots -->
        <img src="https://path-to-your-screenshot.jpg" alt="Dashboard screenshot">
        <!-- Embed interactive Power BI (if using Publish to Web) -->
        <iframe src="https://app.powerbi.com/reportEmbed?reportId=your-report-id&autoAuth=true&ctid=your-tenant-id"></iframe>
        
        <h3>Project 2: ...</h3>
        <!-- Repeat for more projects -->
    </section>

    <footer>
        <p>Contact: your.email@example.com</p>
    </footer>
</body>
</html>
